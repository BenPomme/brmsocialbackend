# Postgres local (docker compose maps 5433 → 5432)
DATABASE_URL="postgresql://babyrock:babyrock@localhost:5433/babyrock"

# Hard rule for this proto: keep false. Workers SMTP / WhatsApp / SMS will not start.
OUTBOUND_ENABLED=false

# Places API (New) — required to see real Maps listings and review texts
GOOGLE_PLACES_API_KEY=""

# Optional. Without it, Scope uses a small parser and drafts are templates.
XAI_API_KEY=""
XAI_MODEL="grok-4.3"
XAI_FAST_MODEL="grok-4.3"

# Cookie signing. Change before anything leaves your machine.
SESSION_SECRET="babyrock-proto-session-secret-do-not-use-in-prod"

# Cap Places spend per Appliquer / Relancer scout
SCOUT_MAX_PLACES=80
SCOUT_MAX_DETAILS=80

# DataForSEO — Google Reviews (owner_answer). From https://app.dataforseo.com/api-access
# Locations and languages lists are free. Reviews billed per 10 items.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
INSPECT_MAX_DEPTH=150
INSPECT_WINDOW_MONTHS=6

# Zoho Mail API (EU). Refresh token from Self Client; never commit secrets.
ZOHO_DC=eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_MAIL_API=https://mail.zoho.eu
ZOHO_ACCOUNTS_API=https://accounts.zoho.eu
OUTREACH_FROM=rosalia@babyrock.ai
OUTREACH_ALLOWLIST=bpommeraud@babyrock.ai

# WhatsApp Cloud API (notre numéro, pour que les prospects nous écrivent)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
BABYROCK_WHATSAPP_E164=
BABYROCK_WHATSAPP_DISPLAY=

# Stripe (factory). Test keys are enough to simulate /pay. Do not enable Billing 0.7 %.
# Payout IBAN = Revolut Business of the SL, configured in the Stripe Dashboard, not here.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
SITE_URL=https://www.babyrock.ai
# Empty / * / all / open = reply to anyone. Comma-separated E.164 digits = restrict.
WHATSAPP_ALLOWLIST=*
