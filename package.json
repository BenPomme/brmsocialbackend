{
  "name": "babyrock-proto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && npx prisma db push && npx prisma db seed",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "setup": "docker compose up -d && npx prisma db push && npx prisma db seed",
    "scout:city": "tsx scripts/scout-city.ts",
    "loop:santcugat": "tsx scripts/loop-santcugat.ts",
    "compose:outreach": "tsx scripts/compose-outreach.ts",
    "factory": "bash scripts/boot-factory.sh",
    "wa:register": "tsx scripts/register-whatsapp-webhook.ts",
    "stripe:skus": "tsx scripts/stripe-sync-skus.ts",
    "test": "tsx --test src/lib/fiche/*.test.ts src/lib/catalog.test.ts src/lib/rosalia/*.test.ts src/lib/pipeline.test.ts src/lib/whatsapp-send.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
