generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  role         String
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  clientId     String?  @map("client_id")
  client       Client?  @relation("ClientLogin", fields: [clientId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  assignedClients Client[] @relation("OperatorClients")

  @@map("users")
}

model Client {
  id                        String   @id @default(uuid())
  name                      String
  city                      String?
  country                   String?
  googleLocationId          String?  @map("google_location_id")
  placeId                   String?  @unique @map("place_id")
  formattedAddress          String?  @map("formatted_address")
  mapsUri                   String?  @map("maps_uri")
  rating                    Float?
  googleAccountEmailManager String?  @map("google_account_email_manager")
  managerInviteStatus       String   @default("pending") @map("manager_invite_status")
  emailPublic               String?  @map("email_public")
  whatsappSite              String?  @map("whatsapp_site")
  whatsappOwner             String?  @map("whatsapp_owner")
  plan                      String   @default("avis_month")
  status                    String   @default("lead")
  offer                     String?
  trialEndsAt               DateTime? @map("trial_ends_at")
  catchupMonths             Int?      @map("catchup_months")
  stripeOrBizumRef          String?  @map("stripe_or_bizum_ref")
  legalName                 String?  @map("legal_name")
  taxId                     String?  @map("tax_id")
  billingEmail              String?  @map("billing_email")
  billingLine1              String?  @map("billing_line1")
  billingPostcode           String?  @map("billing_postcode")
  billingCity               String?  @map("billing_city")
  billingCountry            String?  @map("billing_country")
  vatMode                   String?  @map("vat_mode")
  stripeCustomerId          String?  @map("stripe_customer_id")
  stripeInvoiceId           String?  @map("stripe_invoice_id")
  categoryId                String?  @map("category_id")
  category                  ScopeCategory? @relation(fields: [categoryId], references: [id])
  operatorId                String?  @map("operator_id")
  operator                  User?    @relation("OperatorClients", fields: [operatorId], references: [id])
  toneNotes                 String?  @map("tone_notes")
  publishLive               Boolean  @default(false) @map("publish_live")
  ratingCount               Int?     @map("rating_count")
  createdAt                 DateTime @default(now()) @map("created_at")

  loginUsers User[]              @relation("ClientLogin")
  avis       Avis[]
  actions    Action[]
  messages   MessageWhatsapp[]
  lead       Lead?
  ficheSnapshots FicheSnapshot[]
  inboxThreads InboxThread[]
  payRegistration PayRegistration?
  paymentEvidence PaymentEvidence[]
  replyApprovals  ReplyApproval[]

  @@map("clients")
}

model ScopeCity {
  id      String  @id @default(uuid())
  name    String
  country String
  active  Boolean @default(false)
  source  String

  @@unique([name, country])
  @@map("scope_cities")
}

model ScopeScan {
  id            String   @id @default(uuid())
  areaName      String   @map("area_name")
  country       String
  categorySlug  String   @map("category_slug")
  scannedAt     DateTime @default(now()) @map("scanned_at")
  actor         String
  @@unique([areaName, country, categorySlug])
  @@map("scope_scans")
}

model ScopeCategory {
  id         String  @id @default(uuid())
  slug       String  @unique
  label      String
  active     Boolean @default(false)
  placesType String  @map("places_type")
  source     String  @default("admin")

  clients Client[]

  @@map("scope_categories")
}

model ScopeChange {
  id         String   @id @default(uuid())
  actor      String
  rawMessage String   @map("raw_message")
  reply      String?
  diff       Json
  status     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("scope_changes")
}

model Avis {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  googleReviewId   String    @unique @map("google_review_id")
  stars            Int
  lang             String?
  authorPublicName String?   @map("author_public_name")
  body             String
  reviewedAt       DateTime? @map("reviewed_at")
  status           String
  vanishedAt       DateTime? @map("vanished_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  reponses Reponse[]
  actions  Action[]
  messages MessageWhatsapp[]
  approvals ReplyApproval[]

  @@index([clientId, status])
  @@map("avis")
}

model Reponse {
  id              String   @id @default(uuid())
  avisId          String   @map("avis_id")
  avis            Avis     @relation(fields: [avisId], references: [id], onDelete: Cascade)
  version         Int
  draftModel      String?  @map("draft_model")
  draftText       String?  @map("draft_text")
  operatorText    String?  @map("operator_text")
  sentToOwnerText String?  @map("sent_to_owner_text")
  publishedText   String?  @map("published_text")
  actor           String
  createdAt       DateTime @default(now()) @map("created_at")

  approvals ReplyApproval[]

  @@unique([avisId, version])
  @@map("reponses")
}

model Action {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  avisId    String?  @map("avis_id")
  avis      Avis?    @relation(fields: [avisId], references: [id], onDelete: SetNull)
  type      String
  actor     String
  payload   Json
  result    String
  errorText String?  @map("error_text")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([type])
  @@map("actions")
}

model MessageWhatsapp {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  avisId        String?  @map("avis_id")
  avis          Avis?    @relation(fields: [avisId], references: [id], onDelete: SetNull)
  direction     String
  body          String
  providerMsgId String?  @map("provider_msg_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("messages_whatsapp")
}

model FicheSnapshot {
  id                  String   @id @default(uuid())
  clientId            String   @map("client_id")
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  takenAt             DateTime @default(now()) @map("taken_at")
  source              String
  name                String?
  phone               String?
  address             String?
  hoursText           String?  @map("hours_text")
  businessStatus      String?  @map("business_status")
  rating              Float?
  ratingCount         Int?     @map("rating_count")
  reviewIds           Json?    @map("review_ids")
  calls               Int?
  directionRequests   Int?     @map("direction_requests")
  suggestedEdits      Json?    @map("suggested_edits")
  raw                 Json?

  @@index([clientId, takenAt])
  @@map("fiche_snapshots")
}

model Job {
  id        String    @id @default(uuid())
  kind      String
  payload   Json
  status    String
  attempts  Int       @default(0)
  runAfter  DateTime? @map("run_after")
  lockedAt  DateTime? @map("locked_at")
  errorText String?   @map("error_text")
  result    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, kind])
  @@map("jobs")
}

model Lead {
  id               String    @id @default(uuid())
  placeId          String    @unique @map("place_id")
  name             String
  city             String
  country          String?
  categorySlug     String?   @map("category_slug")
  email            String?
  waSite           String?   @map("wa_site")
  mapsPhone        String?   @map("maps_phone")
  websiteUri       String?   @map("website_uri")
  formattedAddress String?   @map("formatted_address")
  mapsUri          String?   @map("maps_uri")
  rating           Float?
  userRatingCount  Int?      @map("user_rating_count")
  channelPlan      String    @default("skip") @map("channel_plan")
  status           String    @default("new")
  source           String    @default("scout")
  contactSource    String?   @map("contact_source")
  contactActor     String?   @map("contact_actor")
  lastTouchAt      DateTime? @map("last_touch_at")
  clientId         String?   @unique @map("client_id")
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at")

  inspectAt          DateTime? @map("inspect_at")
  inspectReviews6m   Int?      @map("inspect_reviews_6m")
  inspectReplied6m   Int?      @map("inspect_replied_6m")
  inspectUnreplied6m Int?      @map("inspect_unreplied_6m")
  inspectVerdict     String?   @map("inspect_verdict")
  inspectTruncated   Boolean?  @map("inspect_truncated")
  inspectCostUsd     Float?    @map("inspect_cost_usd")
  inspectError       String?   @map("inspect_error")
  inspectSample      Json?     @map("inspect_sample")

  outreachTo          String?   @map("outreach_to")
  outreachSubject     String?   @map("outreach_subject")
  outreachBody        String?   @map("outreach_body")
  outreachComposedAt  DateTime? @map("outreach_composed_at")
  outreachStatus      String?   @map("outreach_status")
  outreachNote        String?   @map("outreach_note")

  inboxThreads InboxThread[]

  @@map("leads")
}

model InboxThread {
  id            String   @id @default(uuid())
  channel       String
  kind          String   @default("outreach")
  counterparty  String
  subject       String?
  status        String   @default("open")
  firstName     String?  @map("first_name")
  preferredLang String?  @map("preferred_lang")
  phase         String   @default("outreach")
  onboardingStep String? @map("onboarding_step")
  lastInboundAt DateTime? @map("last_inbound_at")
  city          String?
  leadId        String?  @map("lead_id")
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId      String?  @map("client_id")
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  messages InboxMessage[]

  @@unique([channel, counterparty])
  @@index([lastMessageAt])
  @@map("inbox_threads")
}

model InboxMessage {
  id         String      @id @default(uuid())
  threadId   String      @map("thread_id")
  thread     InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction  String
  body       String
  providerId String?     @unique @map("provider_id")
  payload    Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@map("inbox_messages")
}

model PayRegistration {
  id             String   @id @default(uuid())
  clientId       String   @unique @map("client_id")
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  capabilityHash String   @map("capability_hash")
  expiresAt      DateTime @map("expires_at")
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("pay_registrations")
}

model PaymentEvidence {
  id                String    @id @default(uuid())
  clientId          String    @map("client_id")
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String    @map("provider_payment_id")
  product           String
  interval          String
  amount            Int?
  currency          String    @default("eur")
  livemode          Boolean   @default(false)
  periodStart       DateTime? @map("period_start")
  periodEnd         DateTime? @map("period_end")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerPaymentId])
  @@index([clientId])
  @@map("payment_evidence")
}

model ProviderEvent {
  id               String   @id @default(uuid())
  provider         String
  receivingAccount String   @map("receiving_account")
  eventId          String   @map("event_id")
  eventTime        DateTime @map("event_time")
  payload          Json
  state            String   @default("accepted")
  jobId            String?  @map("job_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([provider, receivingAccount, eventId])
  @@index([state, createdAt])
  @@map("provider_events")
}

model ReplyApproval {
  id        String   @id @default(uuid())
  avisId    String   @map("avis_id")
  avis      Avis     @relation(fields: [avisId], references: [id], onDelete: Cascade)
  reponseId String   @map("reponse_id")
  reponse   Reponse  @relation(fields: [reponseId], references: [id], onDelete: Cascade)
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor     String
  decision  String
  valid     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reponseId, decision])
  @@index([avisId, reponseId])
  @@map("reply_approvals")
}
